# Documentation only: set these variables in the process/server settings.
# Do not put real tokens in this example. The bot does not automatically load .env.
DISCORD_BOT_TOKEN=
KINGSHOT_ENABLE_LIVE_REDEMPTION=0
KINGSHOT_ENABLE_CODE_SHARING=0
# Only use a verified HTTPS endpoint supplied by the service operator.
KINGSHOT_CODE_SHARING_URL=
